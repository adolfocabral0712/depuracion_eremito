{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "depuracion-eremito",

  "main": "src/index.js",

  "compatibility_date": "2026-10-29",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "observability": {
    "enabled": true
  }
}
